# Copy this file to vault.yml and fill in every value you need.
#
#   cp group_vars/all/vault.yml.example group_vars/all/vault.yml
#   # edit it, then optionally encrypt it:
#   ansible-vault encrypt group_vars/all/vault.yml
#
# vault.yml is git-ignored. If you encrypt it, pass --ask-vault-pass or
# --vault-password-file when running the playbook.
#
# Generate the master key with:
#   openssl rand -base64 32
#
# Keep the master key safe. Losing it makes every stored resume unreadable.
# The database password can be any long random string; the playbook URL-encodes
# it when building the connection string.

resumaker_master_key: ""
resumaker_db_password: ""

# Let's Encrypt account email.
resumaker_letsencrypt_email: ""

# Configure at least one OAuth provider. Leave the other pair empty.
resumaker_github_client_id: ""
resumaker_github_client_secret: ""
resumaker_google_client_id: ""
resumaker_google_client_secret: ""

# Optional: enables "Tailor with Gemini". Leave empty to disable the feature.
resumaker_gemini_api_key: ""
