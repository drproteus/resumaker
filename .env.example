# Copy to .env (git-ignored) and fill in. Never commit the real .env.

RESUMAKER_DATABASE_URL=postgres://resumaker:resumaker@localhost:5432/resumaker?sslmode=disable
RESUMAKER_MASTER_KEY=
RESUMAKER_BASE_URL=http://localhost:8080
RESUMAKER_LISTEN_ADDR=:8080

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

